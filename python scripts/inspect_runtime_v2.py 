class DurableIdempotencyLedger:
    """Durable JSON-backed ledger tracking side-effect execution keys across crashes/restarts."""

    def __init__(self, ledger_path: Path) -> None:
        self._path = ledger_path
        self._path.parent.mkdir(parents=True, exist_ok=True)
        self._io_lock = asyncio.Lock()
        if not self._path.exists():
            self._atomic_write({})

    def _atomic_write(self, data: dict[str, Any]) -> None:
        tmp_path = self._path.with_name(f".{self._path.name}.{uuid.uuid4().hex}.tmp")
        tmp_path.write_text(
            json.dumps(data, indent=2, sort_keys=True, default=str),
            encoding="utf-8",
        )
        os.replace(tmp_path, self._path)

    def _read_unlocked(self) -> dict[str, Any]:
        if not self._path.exists():
            return {}
        raw = self._path.read_text(encoding="utf-8").strip()
        if not raw:
            return {}
        parsed = json.loads(raw)
        return parsed if isinstance(parsed, dict) else {}

    async def execute_idempotent(
        self,
        idempotency_key: str,
        effect_fn: Any,
    ) -> tuple[Any, bool]:
        """Execute `effect_fn` at most once for `idempotency_key`.

        Returns `(result, was_replayed)`.
        """
        async with self._io_lock:
            existing = self._read_unlocked()
            if idempotency_key in existing and existing[idempotency_key].get("committed"):
                return existing[idempotency_key].get("result"), True

        result = await _maybe_await(effect_fn())

        async with self._io_lock:
            latest = self._read_unlocked()
            if idempotency_key in latest and latest[idempotency_key].get("committed"):
                return latest[idempotency_key].get("result"), True
            latest[idempotency_key] = {
                "committed": True,
                "result": result,
            }
            self._atomic_write(latest)
        return result, False


class ExternalCheckpointSigner:
    """Stores SHA-256 and HMAC-SHA256 metadata outside the checkpoint file/directory."""

    def __init__(self, signing_key: bytes, metadata_dir: Path) -> None:
        if not signing_key:
            raise ValueError("HMAC signing key must be non-empty.")
        self._signing_key = signing_key
        self._metadata_dir = metadata_dir
        self._metadata_dir.mkdir(parents=True, exist_ok=True)

    def _meta_file(self, target_path: Path) -> Path:
        path_digest = hashlib.sha256(str(target_path.resolve()).encode("utf-8")).hexdigest()
        return self._metadata_dir / f"{path_digest}.sig.json"

    @staticmethod
    def _compute_bytes(target_path: Path) -> bytes:
        if target_path.is_file():
            return target_path.read_bytes()
        if target_path.is_dir():
            hasher = hashlib.sha256()
            for child in sorted(target_path.rglob("*")):
                if child.is_file():
                    hasher.update(str(child.relative_to(target_path)).encode("utf-8"))
                    hasher.update(b"\x00")
                    hasher.update(child.read_bytes())
                    hasher.update(b"\x01")
            return hasher.digest()
        raise FileNotFoundError(f"Checkpoint path does not exist: {target_path}")

    def sign(self, target_path: Path, checkpoint_id: str | None = None) -> dict[str, Any]:
        """Compute SHA-256 + HMAC-SHA256 outside the checkpoint artifact and persist."""
        payload_bytes = self._compute_bytes(target_path)
        sha256_hex = hashlib.sha256(payload_bytes).hexdigest()
        hmac_hex = hmac.new(self._signing_key, payload_bytes, hashlib.sha256).hexdigest()
        record = {
            "checkpoint_id": checkpoint_id or target_path.stem,
            "target_path": str(target_path.resolve()),
            "sha256": sha256_hex,
            "hmac_sha256": hmac_hex,
        }
        self._meta_file(target_path).write_text(
            json.dumps(record, indent=2, sort_keys=True),
            encoding="utf-8",
        )
        return record

    def verify(self, target_path: Path, checkpoint_id: str | None = None) -> CheckpointVerificationDTO:
        """Verify SHA-256 and HMAC-SHA256 before checkpoint restore."""
        if not target_path.exists():
            return CheckpointVerificationDTO(
                valid=False,
                reason="checkpoint_not_found",
                checkpoint_id=checkpoint_id,
                hmac_verified=False,
            )

        meta_path = self._meta_file(target_path)
        if not meta_path.exists():
            return CheckpointVerificationDTO(
                valid=False,
                reason="missing_external_signature",
                checkpoint_id=checkpoint_id,
                hmac_verified=False,
            )

        try:
            meta = json.loads(meta_path.read_text(encoding="utf-8"))
            payload_bytes = self._compute_bytes(target_path)
        except Exception as exc:
            return CheckpointVerificationDTO(
                valid=False,
                reason=f"checkpoint_read_error:{exc}",
                checkpoint_id=checkpoint_id,
                hmac_verified=False,
            )

        actual_sha256 = hashlib.sha256(payload_bytes).hexdigest()
        actual_hmac = hmac.new(self._signing_key, payload_bytes, hashlib.sha256).hexdigest()

        expected_sha256 = str(meta.get("sha256", ""))
        expected_hmac = str(meta.get("hmac_sha256", ""))

        sha_ok = hmac.compare_digest(actual_sha256, expected_sha256)
        hmac_ok = hmac.compare_digest(actual_hmac, expected_hmac)

        if not sha_ok:
            return CheckpointVerificationDTO(
                valid=False,
                reason="sha256_mismatch",
                checkpoint_id=checkpoint_id or meta.get("checkpoint_id"),
                sha256=actual_sha256,
                hmac_verified=False,
            )
        if not hmac_ok:
            return CheckpointVerificationDTO(
                valid=False,
                reason="hmac_signature_invalid",
                checkpoint_id=checkpoint_id or meta.get("checkpoint_id"),
                sha256=actual_sha256,
                hmac_verified=False,
            )

        return CheckpointVerificationDTO(
            valid=True,
            reason="verified",
            checkpoint_id=checkpoint_id or meta.get("checkpoint_id"),
            sha256=actual_sha256,
            hmac_verified=True,
        )


