def _find_runtime_class(class_name: str) -> type[Any] | None:
    """Locate a runtime class across standard package paths without silent faking."""
    module_candidates = (
        f"enterprise_agent_runtime.{class_name.lower()}",
        f"enterprise_agent_runtime.skills.{class_name.lower()}",
        f"enterprise_agent_runtime.workflow.{class_name.lower()}",
        f"enterprise_agent_runtime.state.{class_name.lower()}",
        f"enterprise_agent_runtime.checkpoint.{class_name.lower()}",
        f"enterprise_agent_runtime.checkpoints.{class_name.lower()}",
        f"enterprise_agent_runtime.mcp.{class_name.lower()}",
        f"enterprise_agent_runtime.core.{class_name.lower()}",
        "enterprise_agent_runtime",
        "enterprise_agent_runtime.skills",
        "enterprise_agent_runtime.workflow",
        "enterprise_agent_runtime.state",
        "enterprise_agent_runtime.checkpoint",
        "enterprise_agent_runtime.checkpoints",
        "enterprise_agent_runtime.mcp",
        "your_project.runtime",
    )
    for mod_path in module_candidates:
        try:
            mod = importlib.import_module(mod_path)
            sym = getattr(mod, class_name, None)
            if isinstance(sym, type):
                return sym
        except ImportError:
            continue
    return None


def _construct_with_candidates(cls: type[Any], candidates: list[tuple[tuple[Any, ...], dict[str, Any]]]) -> Any:
    """Instantiate a class using the first signature candidate that succeeds cleanly."""
    last_exc: Exception | None = None
    for args, kwargs in candidates:
        try:
            return cls(*args, **kwargs)
        except TypeError as exc:
            last_exc = exc
            continue
    if last_exc is not None:
        raise last_exc
    return cls()


async def _maybe_await(value: Any) -> Any:
    """Await coroutines/awaitables while returning synchronous values directly."""
    if inspect.isawaitable(value):
        return await value
    return value


def _build_dto(dto_cls: Any, fallback_cls: type[Any], **kwargs: Any) -> Any:
    """Construct the contracts DTO if compatible, falling back to local dataclass."""
    for target in (dto_cls, fallback_cls):
        if target is None:
            continue
        try:
            if dataclasses.is_dataclass(target):
                valid_fields = {f.name for f in dataclasses.fields(target)}
                filtered = {k: v for k, v in kwargs.items() if k in valid_fields}
                return target(**filtered)
            return target(**kwargs)
        except TypeError:
            continue
    return fallback_cls(**kwargs)


def _is_crash_exception(exc: BaseException) -> bool:
    """Identify crash exceptions that must never be swallowed."""
    crash_names = {"SimulatedProcessCrash", "ProcessCrashError", "SimulatedCrash"}
    return isinstance(exc, (SimulatedProcessCrash, SystemExit, KeyboardInterrupt)) or (
        type(exc).__name__ in crash_names
    )


