async def emit_fault_point(
    fault_injector: Any,
    point_name: str,
    context: dict[str, Any] | None = None,
) -> Any:
    """Trigger a fault injection point on the session's FaultInjector instance.

    - Applies async delays (`asyncio.sleep`) without blocking the event loop.
    - Never catches or suppresses SimulatedProcessCrash or crash exceptions.
    """
    if fault_injector is None:
        return None

    payload = dict(context or {})
    payload.setdefault("point", point_name)

    method_names = (
        "inject",
        "trigger",
        "on_point",
        "check",
        "apply",
        "fault",
        "run_point",
    )
    for method_name in method_names:
        hook = getattr(fault_injector, method_name, None)
        if not callable(hook):
            continue

        try:
            sig = inspect.signature(hook)
            positional_params = [
                p
                for p in sig.parameters.values()
                if p.kind in (p.POSITIONAL_ONLY, p.POSITIONAL_OR_KEYWORD)
            ]
            if len(positional_params) >= 2:
                outcome = hook(point_name, payload)
            elif len(positional_params) == 1:
                outcome = hook(point_name)
            else:
                outcome = hook()
        except (TypeError, ValueError):
            outcome = hook(point_name, payload)
        except BaseException as exc:
            if _is_crash_exception(exc):
                raise
            raise

        try:
            outcome = await _maybe_await(outcome)
        except BaseException as exc:
            if _is_crash_exception(exc):
                raise
            raise

        # Handle structured delay instructions asynchronously
        delay_seconds: float | None = None
        if isinstance(outcome, dict):
            for key in ("delay_seconds", "delay", "sleep_seconds"):
                if key in outcome and outcome[key] is not None:
                    delay_seconds = float(outcome[key])
                    break
        elif hasattr(outcome, "delay_seconds") and getattr(outcome, "delay_seconds") is not None:
            delay_seconds = float(getattr(outcome, "delay_seconds"))

        if delay_seconds is not None and delay_seconds > 0:
            await asyncio.sleep(delay_seconds)

        # If a fault object carries an exception to raise, raise it explicitly
        exc_to_raise = None
        if isinstance(outcome, dict) and isinstance(outcome.get("exception"), BaseException):
            exc_to_raise = outcome["exception"]
        elif hasattr(outcome, "exception") and isinstance(getattr(outcome, "exception"), BaseException):
            exc_to_raise = getattr(outcome, "exception")

        if exc_to_raise is not None:
            raise exc_to_raise

        return outcome

    return None


